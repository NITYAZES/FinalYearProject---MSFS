# ====================================

# FORCE HTTPS ONLY

# ====================================

<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteCond %{HTTPS} !=on
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

</IfModule>

# ====================================

# SECURITY HEADERS

# ====================================

<IfModule mod_headers.c>
    # Content Security Policy
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self';"
    
    # Anti-clickjacking protection
    Header always set X-Frame-Options "DENY"
    
    # Prevent MIME type sniffing
    Header always set X-Content-Type-Options "nosniff"
    
    # XSS Protection for legacy browsers
    Header always set X-XSS-Protection "1; mode=block"
    
    # Referrer Policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    
    # Hide server version information
    Header always unset Server
    Header always unset X-Powered-By
</IfModule>

# ====================================

# PREVENT DIRECTORY LISTING

# ====================================

Options -Indexes

# ====================================

# BLOCK SENSITIVE FILES (Apache 2.2 & 2.4 Compatible)

# ====================================

# Block composer files

<Files "composer.json">
Order allow,deny
Deny from all
</Files>

<Files "composer.lock">
Order allow,deny
Deny from all
</Files>

# Block .env files

<Files ".env">
Order allow,deny
Deny from all
</Files>

# Block .htaccess itself

<Files ".htaccess">
Order allow,deny
Deny from all
</Files>

# Block log files

<FilesMatch "\.(log|sql)$">
Order allow,deny
Deny from all
</FilesMatch>

# Block backup files

<FilesMatch "\.(bak|backup|old|orig|save)$">
Order allow,deny
Deny from all
</FilesMatch>

# Block config files

<FilesMatch "\.(ini|conf|config)$">
Order allow,deny
Deny from all
</FilesMatch>

# ====================================

# ERROR DOCUMENTS

# ====================================

ErrorDocument 404 /FinalYearProject/404.html
ErrorDocument 403 /FinalYearProject/403.html

# ====================================

# SET HOMEPAGE

# ====================================

# Define the default homepage to be homepage.html
DirectoryIndex homepage.html
